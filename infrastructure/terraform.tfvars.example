# main.tf — Azure infrastructure for PR Risk Analyzer
# Maps to AWS equivalents:
# azurerm_resource_group = AWS Account/Region scope
# azurerm_key_vault = AWS Secrets Manager
# azurerm_container_group = AWS ECS Task

terraform {
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 3.0"
    }
  }
}

provider "azurerm" {
  features {}
}

# Resource group — logical container for all resources (like an AWS region scope)
resource "azurerm_resource_group" "main" {
  name     = var.resource_group_name
  location = var.location
}

# Key Vault — stores secrets like GitHub PAT and Claude API key (like AWS Secrets Manager)
resource "azurerm_key_vault" "main" {
  name                = var.key_vault_name
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name
  tenant_id           = var.tenant_id
  sku_name            = "standard"
}

# Container group — runs the analyzer tool (like AWS ECS)
resource "azurerm_container_group" "analyzer" {
  name                = "pr-risk-analyzer"
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name
  os_type             = "Linux"

  container {
    name   = "analyzer"
    image  = "python:3.11-slim"
    cpu    = "0.5"
    memory = "1.5"
  }
}

# Variables — values passed in at deploy time, not hardcoded
variable "resource_group_name" { default = "pr-risk-analyzer-rg" }
variable "location"            { default = "East US" }
variable "key_vault_name"      { default = "pr-analyzer-vault" }
variable "tenant_id"           { description = "Azure tenant ID" }